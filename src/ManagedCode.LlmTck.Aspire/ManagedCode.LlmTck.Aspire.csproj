<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>ManagedCode.LlmTck.Aspire</PackageId>
    <Description>Aspire AppHost resource extensions for ManagedCode.LlmTck provider emulation.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <None
      Include="buildTransitive\ManagedCode.LlmTck.Aspire.targets"
      Pack="true"
      PackagePath="buildTransitive\ManagedCode.LlmTck.Aspire.targets"
      Visible="false" />
  </ItemGroup>

  <Target Name="PublishPackagedLlmTckService" BeforeTargets="_GetPackageFiles">
    <PropertyGroup>
      <LlmTckServicePublishDir>$(MSBuildThisFileDirectory)obj/$(Configuration)/service-publish/</LlmTckServicePublishDir>
    </PropertyGroup>
    <RemoveDir Directories="$(LlmTckServicePublishDir)" />
    <MSBuild
      Projects="$(MSBuildThisFileDirectory)../../samples/ManagedCode.LlmTck.Service/ManagedCode.LlmTck.Service.csproj"
      Targets="Publish"
      Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework);PublishDir=$(LlmTckServicePublishDir);UseAppHost=false;SelfContained=false;NoBuild=false"
      RemoveProperties="PackageOutputPath;NoBuild;RuntimeIdentifier" />
    <Error Condition="!Exists('$(LlmTckServicePublishDir)wwwroot/_framework/blazor.web.js')"
           Text="Published LlmTck service is missing Blazor JavaScript assets." />
    <ItemGroup>
      <_PublishedLlmTckService Include="$(LlmTckServicePublishDir)**/*" />
      <None Include="@(_PublishedLlmTckService)"
            Pack="true"
            PackagePath="tools/llm-tck-service/%(_PublishedLlmTckService.RecursiveDir)%(_PublishedLlmTckService.Filename)%(_PublishedLlmTckService.Extension)"
            Visible="false" />
    </ItemGroup>
  </Target>
</Project>
